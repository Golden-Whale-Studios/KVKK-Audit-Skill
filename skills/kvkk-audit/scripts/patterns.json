[
  {"id":"pd-national-id","ruleId":"KVKK-PD-001","description":"Turkish national ID (TCKN) field name","regex":"tckn|tc_?kimlik|tc_?no|national_?id|identity_?number|kimlik_?no","flags":"i"},
  {"id":"pd-national-id-value","ruleId":"KVKK-PD-001","description":"11-digit number resembling a TCKN","regex":"(?<![\\d.])[1-9]\\d{10}(?![\\d.])"},
  {"id":"pd-phone-field","ruleId":"KVKK-PD-001","description":"Phone number field name","regex":"phone_?(number|no)?\\b|\\btelefon|cep_?tel|gsm|mobile_?(number|no)","flags":"i"},
  {"id":"pd-phone-value","ruleId":"KVKK-PD-001","description":"Turkish phone number literal","regex":"(\\+90|\\b0)\\s?\\(?5\\d{2}\\)?[\\s-]?\\d{3}[\\s-]?\\d{2}[\\s-]?\\d{2}\\b"},
  {"id":"pd-email-field","ruleId":"KVKK-PD-001","description":"E-mail field name","regex":"e-?mail|e_?posta|eposta","flags":"i"},
  {"id":"pd-email-value","ruleId":"KVKK-PD-001","description":"E-mail address literal","regex":"[A-Za-z0-9._%+-]{1,64}@[A-Za-z0-9-]{1,63}(\\.[A-Za-z0-9-]{1,63}){0,4}\\.[A-Za-z]{2,24}"},
  {"id":"pd-iban","ruleId":"KVKK-PD-001","description":"IBAN field name or Turkish IBAN literal","regex":"\\biban\\b|\\bTR\\d{2}(\\s?\\d{4}){5}\\s?\\d{2}\\b","flags":"i"},
  {"id":"pd-address","ruleId":"KVKK-PD-001","description":"Address field name","regex":"\\b(home_?|billing_?|shipping_?|street_?)?address\\b|\\badres\\b|posta_?kodu|zip_?code|postal_?code","flags":"i"},
  {"id":"pd-birthdate","ruleId":"KVKK-PD-001","description":"Birth date field name","regex":"birth_?(date|day)|date_?of_?birth|\\bdob\\b|dogum_?(tarihi|yeri)|doğum_?tarihi|birthdate","flags":"i"},
  {"id":"pd-person-name","ruleId":"KVKK-PD-001","description":"Person name fields","regex":"first_?name|last_?name|sur_?name|full_?name|soyad","flags":"i"},
  {"id":"sp-health","ruleId":"KVKK-SP-001","description":"Health data terms","regex":"\\b(health|saglik|sağlık|diagnosis|diagnoz|teşhis|teshis|medical|hastal[iı]k|disease|prescription|reçete|recete|patient|hasta|blood_?(type|group)|bloodtype|kan_?grubu|allergy|alerji|disability|engel(li|lilik))\\b","flags":"i"},
  {"id":"sp-biometric","ruleId":"KVKK-SP-001","description":"Biometric data terms","regex":"biometric|biyometri|fingerprint|parmak_?izi|face_?(id|recognition|template|embedding)|yüz_?tan[iı]ma|iris_?scan|voiceprint","flags":"i"},
  {"id":"sp-belief-union","ruleId":"KVKK-SP-001","description":"Religion, union, ethnicity, political opinion terms","regex":"\\b(religion|din|mezhep|union_?member|sendika|ethnicity|etnik|political_?(view|opinion)|siyasi|sexual_?orientation)\\b","flags":"i"},
  {"id":"sp-criminal","ruleId":"KVKK-SP-001","description":"Criminal record terms","regex":"criminal_?(record|history)|sabıka|sabika|conviction|mahkumiyet","flags":"i"},
  {"id":"log-personal-data","ruleId":"KVKK-LOG-001","description":"Log call and personal data field on the same line","regex":"(console\\.(log|info|debug|warn|error)|\\blogger\\.|\\bprint\\(|\\bprintln\\(|Log\\.[dive]\\(|\\blogging\\.|\\blog\\.(info|debug|warn|error)).{0,200}(tckn|tc_?kimlik|national_?id|identity_?number|e-?mail|e_?posta|phone|telefon|gsm|iban|address|adres|birth|dogum|password|parola|sifre|şifre|token|first_?name|last_?name|soyad)","flags":"i"},
  {"id":"sec-weak-hash","ruleId":"KVKK-SEC-001","description":"md5/sha1 used with password","regex":"(\\b(md5|sha-?1)\\b.{0,200}(pass|pwd|parola|sifre))|((pass|pwd|parola|sifre).{0,200}\\b(md5|sha-?1)\\b)","flags":"i"},
  {"id":"sec-plain-password-compare","ruleId":"KVKK-SEC-001","description":"Plain text password comparison","regex":"\\b\\w{0,40}password\\w{0,40}\\s*(===?|!==?)\\s*[\\w.\\[\"']|\\.password\\s*==|WHERE\\s+password\\s*=","flags":"i"},
  {"id":"sec-http","ruleId":"KVKK-SEC-002","description":"Unencrypted http:// endpoint (non-local)","regex":"http://(?!localhost|127\\.|0\\.0\\.0\\.0|\\[::1\\]|10\\.|192\\.168\\.|www\\.w3\\.org|schemas\\.|xmlns|example\\.)[\\w.-]+","flags":"i"},
  {"id":"sec-hardcoded-secret","ruleId":"KVKK-SEC-003","description":"Key, secret or password assignment with a literal value","regex":"(api_?key|secret|passwd|password|pwd|token|private_?key|access_?key|client_?secret|auth)\\w{0,40}[\"']?\\s*[:=]\\s*[\"'][^\"'\\s]{6,200}[\"']","flags":"i"},
  {"id":"sec-key-material","ruleId":"KVKK-SEC-003","description":"Private key block or well-known key prefix","regex":"-----BEGIN [A-Z ]*PRIVATE KEY-----|\\bAKIA[0-9A-Z]{16}\\b|\\bsk_live_[0-9A-Za-z]{10,}|\\bAIza[0-9A-Za-z_-]{30,}"},
  {"id":"xb-firebase","ruleId":"KVKK-XB-001","description":"Firebase / Google services","regex":"firebase|firestore|google-services","flags":"i"},
  {"id":"xb-google-analytics","ruleId":"KVKK-XB-001","description":"Google Analytics / gtag / GTM","regex":"google-analytics|googletagmanager|\\bgtag\\b|\\bga\\(['\"]|\\bUA-\\d{4,}-\\d+|\\bG-[A-Z0-9]{8,}\\b"},
  {"id":"xb-sentry","ruleId":"KVKK-XB-001","description":"Sentry","regex":"sentry","flags":"i"},
  {"id":"xb-mixpanel","ruleId":"KVKK-XB-001","description":"Mixpanel","regex":"mixpanel","flags":"i"},
  {"id":"xb-amplitude","ruleId":"KVKK-XB-001","description":"Amplitude","regex":"amplitude","flags":"i"},
  {"id":"xb-segment","ruleId":"KVKK-XB-001","description":"Segment","regex":"segment\\.(com|io)|analytics\\.js|@segment/|analytics-next","flags":"i"},
  {"id":"xb-hotjar","ruleId":"KVKK-XB-001","description":"Hotjar","regex":"hotjar|\\bhj\\(","flags":"i"},
  {"id":"xb-facebook-pixel","ruleId":"KVKK-XB-001","description":"Facebook / Meta Pixel","regex":"fbq\\(|connect\\.facebook\\.net|facebook-pixel|fbevents","flags":"i"},
  {"id":"xb-stripe","ruleId":"KVKK-XB-001","description":"Stripe","regex":"stripe","flags":"i"},
  {"id":"xb-cloud-region","ruleId":"KVKK-XB-001","description":"AWS/GCP/Azure region definition","regex":"\\b(region|location)\\b\\s*[:=]\\s*[\"']?(us|eu|ap|sa|ca|af|me|northamerica|southamerica|europe|asia|australia|westus|eastus|westeurope|northeurope)[a-z0-9-]*|\\b(us|eu|ap|sa|ca|me|af)-(east|west|north|south|central|southeast|northeast)-\\d\\b","flags":"i"},
  {"id":"ck-document-cookie","ruleId":"KVKK-CK-001","description":"Direct cookie access","regex":"document\\.cookie"},
  {"id":"ck-tracking-calls","ruleId":"KVKK-CK-001","description":"Tracking calls fired in code","regex":"\\bgtag\\(|\\bfbq\\("},
  {"id":"ck-analytics-sdk-start","ruleId":"KVKK-CK-001","description":"Analytics SDK started in code (check whether consent comes first)","regex":"FirebaseAnalytics\\.getInstance|setAnalyticsCollectionEnabled\\(\\s*true"}
]
